DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_AUTH_ENABLED=false
APP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CRON_SECRET=replace-with-a-different-random-secret-at-least-32-characters
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
